# Required for the default DeepSeek Anthropic-compatible LLM.
DEEPSEEK_API_KEY=

# Optional. Only used when switching the LLM endpoint to a local Anthropic-compatible server.
ANTHROPIC_AUTH_TOKEN=

# Optional. Used only for the independent Zhipu embedding endpoint.
# When omitted, FeedNote uses local FTS5.
EMBEDDING_API_KEY=

# Optional mobile reminders. Keep the endpoint private because it identifies the push channel.
MOBILE_PUSH_ENDPOINT=https://ntfy.sh/feednote-use-a-long-random-topic
MOBILE_PUSH_TOKEN=

# Optional Feishu spreadsheet sync. Use a published custom app with spreadsheet scopes.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
