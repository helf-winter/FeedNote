# Required for the configured Anthropic-compatible LLM.
ANTHROPIC_AUTH_TOKEN=

# Optional. When omitted, FeedNote tries the LLM key and falls back to local FTS5.
EMBEDDING_API_KEY=

# Optional mobile reminders. Keep the endpoint private because it identifies the push channel.
MOBILE_PUSH_ENDPOINT=https://ntfy.sh/feednote-use-a-long-random-topic
MOBILE_PUSH_TOKEN=

# Optional Feishu spreadsheet sync. Use a published custom app with spreadsheet scopes.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
