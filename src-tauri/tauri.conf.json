{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FeedNote",
  "version": "0.2.0",
  "identifier": "com.feednote.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FeedNote",
        "width": 1180,
        "height": 780,
        "minWidth": 820,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyNDMyQjYyRDJBNTM5QTUKUldTbE9hWFNZaXREMGozU0VOKzI5QzBTU2p1bG1yaWVSOUo4OGhpd2U3akxscjQvWFpQMS9ldnkK",
      "endpoints": [
        "https://github.com/helf-winter/FeedNote/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
