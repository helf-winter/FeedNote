{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for FeedNote application surfaces",
  "windows": ["main", "capture-dot", "capture-menu", "plan-dock"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "dialog:allow-save"
  ]
}
